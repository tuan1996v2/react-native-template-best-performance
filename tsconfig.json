{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "types": ["jest", "node"],
    "strict": true,               // Bắt buộc xử lý null/undefined
    "noImplicitAny": true,        // Không cho phép biến không có type
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],           // Alias gọn nhất cho Super App
    },
    "skipLibCheck": true,         // Tăng tốc độ biên dịch
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "**/Pods"]
}