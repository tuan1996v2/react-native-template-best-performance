{
  "name": "template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "switch-dev": "./build.sh dev && node src/env/scripts/enviroment.js dev",
    "switch-live": "./build.sh prod && node src/env/scripts/enviroment.js production",
    "android": "yarn switch-dev && react-native run-android && yarn port",
    "android-live": "yarn switch-live && react-native run-android",
    "ios": "yarn switch-dev && react-native run-ios",
    "ios-live": "yarn switch-live && react-native run-ios",
    "start": "react-native start --reset-cache",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "rm -rf ~/Library/Developer/Xcode/DerivedData && rm -rf ~/Library/Caches/CocoaPods && rm -rf ios/Pods && rm -f ios/Podfile.lock && watchman watch-del-all && rm -rf node_modules && rm -rf ios/build && yarn install && cd ios && pod install --verbose && cd ..",
    "android-build-APK": "rm -rf build && rm -rf android/build && cd android && ./gradlew clean && ./gradlew assembleRelease && cd .. && APK_PATH=$(find android/app/build/outputs/apk/release -name '*.apk' | head -n 1) && DATE=$(date +%d_%m_%Y) && mv \"$APK_PATH\" \"android/app/build/outputs/apk/release/Mandala-Purchasing-$DATE.apk\"",
    "android-build-AAB": "rm -rf build && rm -rf android/build && cd android && ./gradlew clean && ./gradlew bundleRelease && cd ..",
    "open-folder-apk": "open ./android/app/build/outputs/apk",
    "open-folder-aab": "open ./android/app/build/outputs/bundle",
    "prepare": "husky install",
    "openXcode": "open ios/mandalapurchasing.xcworkspace",
    "openAndroidStudio": "open -a 'Android Studio' android",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "export-android": "mkdir -p android/output && react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/output/index.android.bundle --assets-dest android/output",
    "export-ios": "mkdir -p ios/output && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/output/main.jsbundle --assets-dest ios/output",
    "export-all": "yarn export-android && yarn export-ios",
    "port": "adb reverse tcp:9090 tcp:9090"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.7.0",
    "@hookform/resolvers": "^5.2.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native/new-app-screen": "0.84.0",
    "@react-navigation/elements": "^2.9.5",
    "@react-navigation/native": "^8.0.0-alpha.11",
    "@react-navigation/native-stack": "^8.0.0-alpha.13",
    "@shopify/flash-list": "^2.2.2",
    "axios": "^1.13.5",
    "i18next": "^25.8.13",
    "react": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.4",
    "react-native": "0.84.0",
    "react-native-bootsplash": "^7.1.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-gesture-image-viewer": "^2.1.2",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.2.2",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.3",
    "react-native-video": "^7.0.0-beta.9",
    "react-native-vision-camera": "^5.0.9",
    "react-native-vision-camera-location": "^5.0.9",
    "react-native-vision-camera-resizer": "^5.0.9",
    "react-native-vision-camera-worklets": "^5.0.9",
    "react-native-worklets": "0.7.4",
    "reactotron-react-native": "^5.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.3.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
